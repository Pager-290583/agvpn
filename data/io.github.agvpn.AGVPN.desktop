[Desktop Entry]
Type=Application
Name=AGVPN
GenericName=VPN Client
GenericName[ru]=VPN-клиент
Comment=Unofficial desktop client for AdGuard VPN
Comment[ru]=Неофициальный графический клиент AdGuard VPN
Icon=io.github.agvpn.AGVPN
Exec=agvpn
Terminal=false
Categories=Network;Security;GTK;
Keywords=VPN;AdGuard;privacy;proxy;SOCKS;
StartupNotify=true
SingleMainWindow=true
Actions=connect;disconnect;

[Desktop Action connect]
Name=Connect
Name[ru]=Подключиться
Exec=agvpn --connect

[Desktop Action disconnect]
Name=Disconnect
Name[ru]=Отключиться
Exec=agvpn --disconnect
